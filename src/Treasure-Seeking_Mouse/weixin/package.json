{
  "name": "geo-muse-weixin",
  "version": "0.1.0",
  "private": true,
  "description": "GEO寻宝鼠 · 微信小程序版（Taro + React）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
