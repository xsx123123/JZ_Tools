# 本地自托管 LLM 配置（复制为 server/.env 后填入真实值；.env 已被 .gitignore 忽略）
# 全部可选覆盖项见 functions/seqout-chat/index.ts 头部注释

# 必填：任意 OpenAI 兼容接口的密钥（OpenAI / DeepSeek / 硅基流动 / 本地 vLLM+ngrok 等均可）
# 三种给法，优先级从高到低：
#   1) 服务器/shell 环境变量：export LLM_API_KEY=sk-xxx 后启动，本文件可留空
#   2) 本文件直接填明文：LLM_API_KEY=sk-xxx
#   3) 引用服务器环境变量：LLM_API_KEY=$MY_LLM_KEY（或 ${MY_LLM_KEY}）
LLM_API_KEY=${DP_API_KEY}

# 接口根地址（须以 /v1 结尾，OpenAI 兼容 path 为 {base}/models 与 {base}/chat/completions）
LLM_BASE_URL=https://api.deepseek.com

# 请求未指定模型时的默认值
LLM_MODEL=qwen3.8-flash

# 本地服务端口
CHAT_API_PORT=8787

# seqout 数据 API（一般无需改）
# SEQOUT_BASE_URL=https://seqout.org/api
